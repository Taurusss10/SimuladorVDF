%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1ea5a826fdde60e4aa37e462fdca7ab4, type: 3}
  m_Name: Practica_3
  m_EditorClassIdentifier: VDF::VDF.VdfPractica
  Numero: 3
  Titulo: "Cableado del m\xF3dulo"
  Descripcion: "Conectar con jumpers la alimentaci\xF3n, las salidas del PLC hacia el variador y hacia los indicadores, y la salida a motor."
  EmpezarConfigurado: 1
  EmpezarCableado: 0
  PermiteCablear: 1
  Pasos:
  - Instruccion: "Antes de cablear, comprueba que el breaker est\xE1 abierto."
    Pista: "En el simulador el tablero solo recibe tensi\xF3n cuando el cableado de alimentaci\xF3n est\xE1 hecho; en el equipo real, esto es obligatorio."
    MensajeError: 
    Advertencia: Nunca se manipulan bornes con el tablero energizado.
    Condicion: 0
    Objetivo: 
    Valor: 0
    Tolerancia: 0
  - Instruccion: Lleva la fase L1 del breaker a la entrada R/L1 del variador.
    Pista: "Clic en un borne y clic en el otro. Con el bot\xF3n derecho se borra un cable."
    MensajeError: "Esos dos bornes todav\xEDa no quedan unidos."
    Advertencia: 
    Condicion: 6
    Objetivo: BRK-L1|R/L1
    Valor: 0
    Tolerancia: 0
  - Instruccion: Lleva la fase L2 del breaker a la entrada S/L2.
    Pista: "El V1000 de este m\xF3dulo es monof\xE1sico de entrada: solo R/L1 y S/L2."
    MensajeError: "Esos dos bornes todav\xEDa no quedan unidos."
    Advertencia: 
    Condicion: 6
    Objetivo: BRK-L2|S/L2
    Valor: 0
    Tolerancia: 0
  - Instruccion: "Lleva +24 V al com\xFAn 2L de las salidas del PLC."
    Pista: 2L alimenta las salidas que van a las entradas digitales del variador.
    MensajeError: "Esos dos bornes todav\xEDa no quedan unidos."
    Advertencia: 
    Condicion: 6
    Objetivo: VCC24|PLC-2L
    Valor: 0
    Tolerancia: 0
  - Instruccion: "Lleva 0 V al com\xFAn SC de las entradas digitales del variador."
    Pista: "Sin el com\xFAn, ninguna entrada S puede cerrar circuito."
    MensajeError: "Esos dos bornes todav\xEDa no quedan unidos."
    Advertencia: 
    Condicion: 6
    Objetivo: GND24|SC
    Valor: 0
    Tolerancia: 0
  - Instruccion: Conecta la salida de marcha del PLC a S1.
    Pista: S1 es la orden de marcha, la que configuraste con H1-01 = 40.
    MensajeError: "Esos dos bornes todav\xEDa no quedan unidos."
    Advertencia: 
    Condicion: 6
    Objetivo: PLC-Q0.7|S1
    Valor: 0
    Tolerancia: 0
  - Instruccion: Conecta la multi-velocidad 1 del PLC a S5.
    Pista: 
    MensajeError: "Esos dos bornes todav\xEDa no quedan unidos."
    Advertencia: 
    Condicion: 6
    Objetivo: PLC-Q0.6|S5
    Valor: 0
    Tolerancia: 0
  - Instruccion: Conecta la multi-velocidad 2 del PLC a S6.
    Pista: 
    MensajeError: "Esos dos bornes todav\xEDa no quedan unidos."
    Advertencia: 
    Condicion: 6
    Objetivo: PLC-Q0.5|S6
    Valor: 0
    Tolerancia: 0
  - Instruccion: Conecta el indicador V1 a su salida del PLC.
    Pista: "Los indicadores son de 220 V y van al com\xFAn 1L, que est\xE1 a fase."
    MensajeError: "Esos dos bornes todav\xEDa no quedan unidos."
    Advertencia: 
    Condicion: 6
    Objetivo: PLC-Q0.0|V1-A
    Valor: 0
    Tolerancia: 0
  - Instruccion: Conecta la salida U del variador al motor.
    Pista: 
    MensajeError: "Esos dos bornes todav\xEDa no quedan unidos."
    Advertencia: 
    Condicion: 6
    Objetivo: U_MOT|MOT-U
    Valor: 0
    Tolerancia: 0
  - Instruccion: Conecta la salida V del variador al motor.
    Pista: 
    MensajeError: "Esos dos bornes todav\xEDa no quedan unidos."
    Advertencia: 
    Condicion: 6
    Objetivo: V_MOT|MOT-V
    Valor: 0
    Tolerancia: 0
  - Instruccion: Conecta la salida W del variador al motor.
    Pista: "Si inviertes dos fases, el motor girar\xE1 al rev\xE9s. No es peligroso, pero se nota."
    MensajeError: "Esos dos bornes todav\xEDa no quedan unidos."
    Advertencia: 
    Condicion: 6
    Objetivo: W_MOT|MOT-W
    Valor: 0
    Tolerancia: 0
  - Instruccion: "Completa el resto del cableado hasta que no falte ninguna uni\xF3n."
    Pista: "El panel te dice cu\xE1ntas faltan y cu\xE1l es la primera."
    MensajeError: Revisa las uniones que el panel marca como faltantes.
    Advertencia: 
    Condicion: 7
    Objetivo: 
    Valor: 0
    Tolerancia: 0
  - Instruccion: "Comprueba que no has dejado ning\xFAn cable de m\xE1s."
    Pista: Un cable entre dos redes distintas es un cortocircuito y se marca como tal.
    MensajeError: Hay cables que unen redes que no deben tocarse.
    Advertencia: 
    Condicion: 8
    Objetivo: 
    Valor: 0
    Tolerancia: 0
